package hellofx;

import java.util.Random;
import javafx.event.ActionEvent;
import javafx.fxml.FXML;
import javafx.scene.control.Button;
import javafx.scene.control.Label;
import javafx.scene.layout.GridPane;

public class Controller {

    @FXML
    private Label label;

    @FXML
    private Label counterLabel;

    @FXML
    private Button button1;

    @FXML
    private Button button2;

    private int clickCount = 0;
    private final Random random = new Random();
    
    private static final int MAX_ROWS = 4; 

    public void initialize() {
        String javaVersion = System.getProperty("java.version");
        String javafxVersion = System.getProperty("javafx.version");
        label.setText("Hello, JavaFX " + javafxVersion + "\nRunning on Java " + javaVersion + ".");
        counterLabel.setText("Μετρητής: 0");

        setRandomButtonValues();
    }

    @FXML
    private void onButtonClick(ActionEvent event) {
        Button clickedButton = (Button) event.getSource();
        Button otherButton = (clickedButton == button1) ? button2 : button1;

        int currentRow = (GridPane.getRowIndex(clickedButton) == null) ? 0 : GridPane.getRowIndex(clickedButton);
        int currentCol = (GridPane.getColumnIndex(clickedButton) == null) ? 0 : GridPane.getColumnIndex(clickedButton);

        int otherRow = (GridPane.getRowIndex(otherButton) == null) ? 0 : GridPane.getRowIndex(otherButton);
        int otherCol = (GridPane.getColumnIndex(otherButton) == null) ? 0 : GridPane.getColumnIndex(otherButton);

        int nextRow = currentRow + 1;
        int nextCol = currentCol;

        boolean isWithinBounds = nextRow < MAX_ROWS;
        boolean isCellEmpty = !(nextRow == otherRow && nextCol == otherCol);

        if (isWithinBounds && isCellEmpty) {
            GridPane.setRowIndex(clickedButton, nextRow);

            // Ενημέρωση μετρητή και τυχαίων αριθμών
            clickCount++;
            counterLabel.setText("Μετρητής: " + clickCount);
            setRandomButtonValues();
        }
    }

    private void setRandomButtonValues() {
        int val1 = random.nextInt(9) + 1;
        int val2;
        int val3,val4....val8 ; 

        do {
            val2 = random.nextInt(9) + 1;
        } while (val1 == val2);


        do {
            val3 = random.nextInt(9) + 1;
        } while (val1 == val3 || val2==val3);

     
        do {
            val8 = random.nextInt(9) + 1;
        } while (val1 == val8 || val2==val8 || val3==val8 .... val7==val8);

        button1.setText(String.valueOf(val1));
        button2.setText(String.valueOf(val2));
    }
}
