package hellofx;

import javafx.event.ActionEvent;
import javafx.fxml.FXML;
import javafx.scene.control.Button;
import javafx.scene.control.Label;
import javafx.scene.layout.GridPane;
import java.util.Random;

public class Controller {

    @FXML private Label label;
    @FXML private Label counterLabel;
    @FXML private Label statusLabel;
    @FXML private Button button1;
    @FXML private Button button2;

    private int clickCount = 0;
    private final Random random = new Random(); 

    public void initialize() {
        label.setText("Maximus Math Square: Η Σύγκρουση!");
        counterLabel.setText("Κινήσεις: 0");
        statusLabel.setText("Κάνε κλικ σε ένα κουμπί για να ξεκινήσεις!");

        generateNewValue(button1);
        generateNewValue(button2);
    }

    @FXML
    private void onButtonClick(ActionEvent event) {
        Button clickedButton = (Button) event.getSource();
        Button otherButton = (clickedButton == button1) ? button2 : button1;

        if (!otherButton.isVisible()) {
            statusLabel.setText("Το παιχνίδι τελείωσε! Έχεις ήδη κερδίσει.");
            return;
        }

        generateNewValue(clickedButton);

        int currentCol = getColumn(clickedButton);
        int targetCol = (clickedButton == button1) ? currentCol + 1 : currentCol - 1;

        int otherCol = getColumn(otherButton);

        if (targetCol == otherCol) {
            int clickedVal = Integer.parseInt(clickedButton.getText());
            int otherVal = Integer.parseInt(otherButton.getText());

            if (clickedVal >= otherVal) {
                otherButton.setVisible(false); // Το αντίπαλο κουμπί εξαφανίζεται
                statusLabel.setText("ΕΠΙΚΗ ΝΙΚΗ! Το " + clickedVal + " έφαγε το " + otherVal + "!");
            } else {
                statusLabel.setText("ΑΠΟΤΥΧΙΑ! Το " + clickedVal + " είναι μικρότερο από το " + otherVal + ". Η κίνηση μπλοκαρίστηκε!");
                return; // Ακύρωση κίνησης, δεν αλλάζει το GridPane index
            }
        } else {
            statusLabel.setText("Ασφαλής κίνηση. Ο αριθμός σου άλλαξε!");
        }

        clickCount++;
        counterLabel.setText("Κινήσεις: " + clickCount);
        GridPane.setColumnIndex(clickedButton, targetCol);
    }

    private void generateNewValue(Button button) {
        int num = random.nextInt(10) + 1;
        button.setText(String.valueOf(num));
    }

    private int getColumn(Button button) {
        Integer col = GridPane.getColumnIndex(button);
        return (col == null) ? 0 : col;
    }
}

